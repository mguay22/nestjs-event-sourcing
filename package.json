{
  "name": "nestjs-event-sourcing",
  "version": "0.0.1",
  "description": "NestJS on the Bun runtime — no build step",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "demo": "bun demo.ts",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d --wait",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "g": "bunx @nestjs/cli g"
  },
  "dependencies": {
    "@kurrent/kurrentdb-client": "^1.3.1",
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/mapped-types": "12.0.0",
    "@nestjs/platform-express": "12.1.0",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.0",
    "@types/express": "5.0.6",
    "bun-types": "1.4.2",
    "drizzle-kit": "^0.31.11",
    "oxlint": "1.85.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
